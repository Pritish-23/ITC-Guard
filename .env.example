# ITC Guard uses a deterministic offline mock by default.
ITCGUARD_LLM_PROVIDER=mock

# Deterministic matching defaults. Values are examples, not secrets.
ITCGUARD_AMOUNT_TOLERANCE=1.00
ITCGUARD_MAX_EDIT_DISTANCE=2
ITCGUARD_DATE_TOLERANCE_DAYS=0

# Optional output directory for local runs.
ITCGUARD_OUTPUT_DIR=reports
